---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { page } from '../lib/links';

interface Props {
  /** The page's own name; the home page leaves it out. */
  title?: string;
  description?: string;
}

const SITE_DESCRIPTION =
  'Worgl is an open-source issuer for tokens that cost one bit to track, need no accounts, and expire if they sit still.';
const { title, description = SITE_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · Worgl` : 'Worgl: one bit per token';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- A theme picked in the docs applies here too. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('starlight-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Worgl" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#1D35D6" />
    <link rel="icon" href={page('favicon.svg')} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/grain';
      import '../scripts/motion';
    </script>
  </body>
</html>
