---
// Four layers of a tiny mint as stamp sheets: scripts/stamp-lab.ts.
// The wrapper uses display: contents, so the sheets and the controls sit in the parent's grid.
import '../../styles/figures/stamp-lab.css';
---
<div class="stamp-lab" data-stamp-lab>
  <div class="sheets" data-part="sheets" aria-label="Four layers of a small mint, oldest first"></div>
  <div class="lab-side">
    <div class="controls">
      <button class="btn btn-solid" type="button" data-do="mint">Mint</button>
      <button class="btn" type="button" data-do="transfer">Transfer</button>
      <button class="btn" type="button" data-do="refresh">Refresh</button>
      <button class="btn" type="button" data-do="rotate">Rotate</button>
      <button class="btn" type="button" data-do="reset" aria-label="Reset the layers">Reset</button>
    </div>
    <p class="readout" data-part="readout" aria-live="polite">Four layers, oldest at the top. Click a note to transfer it, or use the buttons.</p>
    <div class="counters"><div><b data-part="rotations">0</b><span class="label muted">Rotations</span></div><div><b data-part="expired">0</b><span class="label muted">Value expired</span></div></div>
    <div class="formula" role="img" aria-label="A note in layer k of n can make n minus 1 minus k more hops now, and dies in rotation k plus 1 if left alone.">
      <span aria-hidden="true">a note in layer <span class="k">k</span> of <span class="k">n</span></span>
      <span aria-hidden="true">· can make <span class="k">n − 1 − k</span> more hops now</span>
      <span aria-hidden="true">· dies in rotation <span class="k">k + 1</span> if left alone</span>
    </div>
  </div>
</div>

<style>
  .stamp-lab { display: contents; }
</style>

<script>
  import { mountStampLab } from '../../scripts/stamp-lab';
  document.querySelectorAll<HTMLElement>('[data-stamp-lab]').forEach(mountStampLab);
</script>
