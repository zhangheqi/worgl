{
  "name": "worgl-purse",
  "version": "0.0.0",
  "private": true,
  "description": "The Worgl Purse: tokens held in this browser, no sign-up",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "mint": "node scripts/dev-mint.mjs",
    "grain": "node scripts/grain.ts",
    "screenshots": "node scripts/preview.mjs",
    "screenshots:send": "node scripts/preview-send.mjs",
    "screenshots:history": "node scripts/preview-history.mjs",
    "screenshots:backup": "node scripts/preview-backup.mjs",
    "plan-check": "node scripts/plan-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "fflate": "0.8.2",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "worgl": "file:../sdk/typescript"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
